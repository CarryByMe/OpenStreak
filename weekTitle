export function monthTitle(year: number, month: number): string {
  const idx = ((month % 12) + 12) % 12;
  const monthName = MONTH_NOM[idx];
  if (!monthName) return `Месяц ${month + 1} ${year}`;
  return monthName[0].toUpperCase() + monthName.slice(1) + ' ' + year;
}

export function weekTitle(cursor: string): string {
  const cur = new Date(cursor + 'T00:00');
  const mondayOffset = (cur.getDay() + 6) % 7;
  const monday = addDays(cursor, -mondayOffset);
  const sunday = addDays(monday, 6);

  const monDate = new Date(monday + 'T00:00');
  const sunDate = new Date(sunday + 'T00:00');

  const monMonthName = MONTH_NOM[monDate.getMonth()] || '';
  const sunMonthName = MONTH_NOM[sunDate.getMonth()] || '';

  if (monDate.getMonth() === sunDate.getMonth()) {
    return `${monDate.getDate()}–${sunDate.getDate()} ${monMonthName}`;
  }
  return `${monDate.getDate()} ${monMonthName} – ${sunDate.getDate()} ${sunMonthName}`;
}
