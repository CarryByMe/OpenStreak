{
  "expo": {
    "name": "OpenStreak",
    "slug": "OpenStreak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "openstreak",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qqqcoder.OpenStreak"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5B82E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.qqqcoder.OpenStreak"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-font",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OpenStreak использует местоположение, чтобы запомнить место для напоминания, когда ты нажимаешь «Я здесь».",
          "locationAlwaysAndWhenInUsePermission": "OpenStreak следит за выбранными тобой местами, чтобы напомнить о деле у магазина или в зале, даже когда приложение закрыто. Координаты остаются на телефоне.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3E9D2",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1D2740"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/golos-text/500Medium/GolosText_500Medium.ttf",
            "./node_modules/@expo-google-fonts/golos-text/700Bold/GolosText_700Bold.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "./node_modules/@expo-google-fonts/rubik/500Medium/Rubik_500Medium.ttf",
            "./node_modules/@expo-google-fonts/rubik/700Bold/Rubik_700Bold.ttf",
            "./node_modules/@expo-google-fonts/unbounded/700Bold/Unbounded_700Bold.ttf",
            "./node_modules/@expo-google-fonts/oswald/700Bold/Oswald_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "TodayMedium",
              "label": "Сегодня — средний",
              "description": "Счёт дня и три ближайших дела, долг первым. Когда всё сделано — кнопка «Закрыть день».",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayLarge",
              "label": "Сегодня — большой",
              "description": "Счёт дня, список дел, «Сделано» и кнопка «+» для нового дела.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "Today",
              "displayName": "Сегодня",
              "description": "Счёт дня и ближайшие дела.",
              "ios": {
                "supportedFamilies": ["systemMedium", "systemLarge"]
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "603dd5c6-4b40-434a-83e5-7f0a8ad5fea4"
      }
    }
  }
}
